# AI Core service key에서 매핑합니다. 실제 비밀값은 루트 .env에만 넣으세요.
AICORE_BASE_URL=
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_RESOURCE_GROUP=default

# 배포된 모델 이름
LLM_MODEL=gpt-5.6-luna
# Luna only supports its default temperature. Use one shared seed for repeatable runs.
LLM_SEED=20261018
# Optional: pin the RUNNING deployment ID for a repeatable AI Core target.
# AICORE_LLM_DEPLOYMENT_ID=your-gpt-5-6-luna-deployment-id

# Maximum seconds to wait for AI Core to send a chat response.
CHAT_TIMEOUT_SECONDS=90

# 선택: SAP BTP Vector Grounding Repository. 설정한 뒤 03 A2A 요청 전에
# 저장소 문서를 근거로 Orchestration/Team Agent가 검토합니다.
# GROUNDING_REPOSITORY_ID=your-vector-collection-id
# 선택: Grounding Orchestration deployment URL. 비우면 실행 중 deployment를 조회합니다.
# AICORE_ORCHESTRATION_DEPLOYMENT_URL=

# 선택: 03 A2A의 MDM/재고 Sub-agent에 제공하는 읽기 전용 SAP HANA 증거 조회입니다.
# 실제 값은 .env 또는 별도로 지정한 HANA_ENV_FILE에만 보관하세요.
# HANA_ENV_FILE=/absolute/path/to/local-hana.env
# HANA_HOST=
# HANA_PORT=443
# HANA_USER=
# HANA_PASSWORD=
# HANA_SCHEMA=
# HANA_ENCRYPT=true
# HANA_SSL_VALIDATE_CERTIFICATE=true

# 선택: LiteLLM Proxy를 OpenAI-compatible endpoint로 사용합니다.
# URL은 LiteLLM Proxy의 /v1 경로까지 지정하세요. 실제 키는 .env에만 보관합니다.
# LITELLM_BASE_URL=https://your-litellm.example/v1
# LITELLM_API_KEY=
# 기존 AI gateway key 이름을 유지해야 한다면 LITELLM_API_KEY 대신 AI_SECRET_KEY를 사용할 수 있습니다.
# LITELLM_MODEL=gpt-5.6-luna

# 현재 AI Core에 배포된 임베딩 모델명으로 변경
EMBED_MODEL=text-embedding-3-small

# AI Core native reranker 및 Harness/decision model용 모델명
RERANK_MODEL=cohere-rerank-pro

# 선택: Harness 라우팅 및 LLM decision model용 LiteLLM/Cohere 호환 endpoint
# RERANK_ENDPOINT=https://your-litellm.example/rerank
# RERANK_API_KEY=

ALLOW_WRITE_TOOLS=false

# 선택: 03 A2A의 사람 승인 Outlook 메일 발송입니다. Orchestration은 메일
# 초안만 만들며, UI에서 사람이 수신자·제목·본문을 확인하고 발송 버튼을
# 눌렀을 때에만 외부 쓰기가 발생합니다.
# 1) sap-app-in-app EAI의 A2A_GRAPH_MAIL_SERVICE_TOKEN과 같은 값을 넣고
# 2) Portal Outlook OAuth를 Mail.Send 권한으로 다시 연결하세요.
# OUTLOOK_GRAPH_SEND_ENDPOINT=http://127.0.0.1:18005/api/erp-eai/outbound/graph-mail/send/
# A2A_GRAPH_MAIL_SERVICE_TOKEN=
# OUTLOOK_GRAPH_SEND_TIMEOUT_SECONDS=30
# 실제 발송을 허용할 때만 true로 변경하세요.
# ALLOW_WRITE_TOOLS=true
