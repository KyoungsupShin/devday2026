# AI Core service key에서 매핑합니다. 실제 비밀값은 루트 .env에만 넣으세요.
AICORE_BASE_URL=
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_RESOURCE_GROUP=default

# 배포된 모델 이름
LLM_MODEL=gpt-5.6-luna

# 선택: LiteLLM Proxy를 OpenAI-compatible endpoint로 사용합니다.
# URL은 LiteLLM Proxy의 /v1 경로까지 지정하세요. 실제 키는 .env에만 보관합니다.
# LITELLM_BASE_URL=https://your-litellm.example/v1
# LITELLM_API_KEY=
# 기존 AI gateway key 이름을 유지해야 한다면 LITELLM_API_KEY 대신 AI_SECRET_KEY를 사용할 수 있습니다.
# LITELLM_MODEL=gpt-5.6-luna

# 현재 AI Core에 배포된 임베딩 모델명으로 변경
EMBED_MODEL=text-embedding-3-small

# AI Core native reranker 및 Harness/decision model용 모델명
RERANK_MODEL=cohere-rerank-pro

# 선택: Harness 라우팅 및 LLM decision model용 LiteLLM/Cohere 호환 endpoint
# RERANK_ENDPOINT=https://your-litellm.example/rerank
# RERANK_API_KEY=

ALLOW_WRITE_TOOLS=false
