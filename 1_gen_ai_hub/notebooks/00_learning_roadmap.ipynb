   "source": [
    "<div style="margin: 8px 0 28px; padding: 36px 38px; border-radius: 20px; color: #ffffff; background: linear-gradient(135deg, #0b1736 0%, #173a78 52%, #0ea5a6 120%); box-shadow: 0 14px 34px rgba(15, 49, 101, .24);">\n",
    "  <div style="font-size: .78em; font-weight: 800; letter-spacing: .14em; opacity: .78;">GEN AI HUB · HANDS-ON</div>\n",
    "  <h1 style="margin: 12px 0 10px; font-size: 2.15em; line-height: 1.2; color: #ffffff;">1~4단계 학습 로드맵</h1>\n",
    "  <p style="max-width: 760px; margin: 0; font-size: 1.04em; line-height: 1.7; color: #e7f4ff;">AI Core 연결에서 시작해 LLM, Grounding, Agent 협업까지. 이 노트북은 실습 전체의 지도이며 실제 설정과 모델 호출은 다음 노트북부터 진행합니다.</p>\n",
    "  <div style="margin-top: 22px; display: flex; flex-wrap: wrap; gap: 8px;">\n",
    "    <span style="padding: 6px 11px; border: 1px solid rgba(255,255,255,.36); border-radius: 999px; font-size: .82em;">01 · AI Core</span>\n",
    "    <span style="padding: 6px 11px; border: 1px solid rgba(255,255,255,.36); border-radius: 999px; font-size: .82em;">02 · LLM</span>\n",
    "    <span style="padding: 6px 11px; border: 1px solid rgba(255,255,255,.36); border-radius: 999px; font-size: .82em;">03 · Services</span>\n",
    "    <span style="padding: 6px 11px; border: 1px solid rgba(255,255,255,.36); border-radius: 999px; font-size: .82em;">04 · Agent Patterns</span>\n",
    "  </div>\n",
    "</div>"
   ]
  },
