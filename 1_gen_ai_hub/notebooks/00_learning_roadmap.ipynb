   "source": [
    "<div style="margin: 0 0 10px; color: #49627f; font-size: .82em; font-weight: 800; letter-spacing: .08em;">MEDIA SLOT</div>\n",
    "<h2 style="margin: 0 0 8px; color: #132744;">썸네일 또는 소개 영상</h2>\n",
    "<p style="margin: 0 0 16px; line-height: 1.65; color: #4b5f78;">아래 셀의 URL만 바꾸면 로드맵 첫 화면에 소개 영상 또는 썸네일을 표시할 수 있습니다. URL을 비워 두면 발표용 자리표시자가 나타납니다.</p>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "media-slot",
   "metadata": {
    "jupyter": {
     "source_hidden": true
    }
   },
   "outputs": [],
   "source": [
    "from html import escape\n",
    "from IPython.display import HTML, display\n",
    "\n",
    "# 소개 영상을 넣으려면 YouTube, Vimeo 등의 embed URL을 입력하세요.\n",
    "# 예: https://www.youtube.com/embed/VIDEO_ID\n",
    "VIDEO_EMBED_URL = ""\n",
    "\n",
    "# 영상 대신 이미지를 먼저 보이게 하려면 공개 접근 가능한 이미지 URL을 입력하세요.\n",
    "THUMBNAIL_URL = ""\n",
    "\n",
    "if VIDEO_EMBED_URL.startswith("https://"):\n",
    "    media_html = (\n",
    "        '<div style=\"position:relative; width:100%; aspect-ratio:16/9; overflow:hidden; border-radius:18px; background:#07152f; box-shadow:0 12px 28px rgba(22,50,89,.18);\">'\n",
    "        f'<iframe src=\"{escape(VIDEO_EMBED_URL, quote=True)}\" title=\"Gen AI Hub 소개 영상\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen style=\"position:absolute; inset:0; width:100%; height:100%; border:0;\"></iframe>'\n",
    "        '</div>'\n",
    "    )\n",
    "elif THUMBNAIL_URL.startswith("https://"):\n",
    "    media_html = (\n",
    "        '<div style=\"position:relative; width:100%; aspect-ratio:16/9; overflow:hidden; border-radius:18px; background:#07152f; box-shadow:0 12px 28px rgba(22,50,89,.18);\">'\n",
    "        f'<img src=\"{escape(THUMBNAIL_URL, quote=True)}\" alt=\"Gen AI Hub 소개 썸네일\" style=\"width:100%; height:100%; object-fit:cover;\">'\n",
    "        '</div>'\n",
    "    )\n",
    "else:\n",
    "    media_html = '''\n",
    "    <div style=\"display:flex; min-height:260px; align-items:center; justify-content:center; border:2px dashed #8ba7c6; border-radius:18px; color:#48627d; background:linear-gradient(135deg, #f3f8fe, #e8f5f5); text-align:center;\">\n",
    "      <div>\n",
    "        <div style=\"margin-bottom:10px; font-size:42px;\">▶</div>\n",
    "        <div style=\"font-weight:800; color:#183b66;\">소개 영상 또는 썸네일 영역</div>\n",
    "        <div style=\"margin-top:6px; font-size:.9em;\">VIDEO_EMBED_URL 또는 THUMBNAIL_URL에 HTTPS 주소를 입력하세요.</div>\n",
    "      </div>\n",
    "    </div>\n",
    "    '''\n",
    "\n",
    "display(HTML(media_html))"
   ]
  },
